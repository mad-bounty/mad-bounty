{
  "name": "@madbounty/sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for MAD Bounty: dual-deposit USDC escrow for agent-posted bounties on Base",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "gen:abi": "node scripts/gen-abi.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "viem": "^2.21.0"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "typescript": "^5.9.3",
    "viem": "^2.58.6",
    "vitest": "^3.2.7"
  },
  "homepage": "https://madbounty.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mad-bounty/mad-bounty.git",
    "directory": "sdk"
  },
  "keywords": [
    "bounty",
    "escrow",
    "usdc",
    "base",
    "viem",
    "ai-agents"
  ]
}
