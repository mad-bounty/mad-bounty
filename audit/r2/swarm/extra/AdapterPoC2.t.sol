pragma solidity ^0.8.24;

import {MADBountyCore, IERC20} from "../../../../src/MADBountyCore.sol";
import {MockUSDC, CoreHelpers} from "../../../../test/MADBountyCore.t.sol";
import {AdapterBase} from "../../../../periphery/src/AdapterBase.sol";
import {FallbackVerifier} from "../../../../periphery/src/FallbackVerifier.sol";
import {MultiVerifier} from "../../../../periphery/src/MultiVerifier.sol";
import {OnchainCheckVerifier} from "../../../../periphery/src/OnchainCheckVerifier.sol";
import {HashRevealVerifier} from "../../../../periphery/src/HashRevealVerifier.sol";
import {TeeMLVerifier} from "../../../../periphery/src/TeeMLVerifier.sol";

/// L-1 PoC: FallbackVerifier.configure accepts n == 1 AND stepTimeout == 0 (the `n > 1` guard leaves the
/// single-signer case unguarded).  That is fine for resolve (0*0 = 0), but it is the same acceptance that lets
/// n == 3 + step 0 through — see L-0.  Kept as documentation that `stepTimeout == 0` is a legal configuration.
contract AdapterPoC2Test is CoreHelpers {
    MockUSDC usdc;
    address treasury = makeAddr("treasury");
    address agent = makeAddr("agent");
    address worker = makeAddr("worker");
    address stranger = makeAddr("stranger");
    bytes32 ev = keccak256("evidence");

    function setUp() public {
        usdc = new MockUSDC();
        core = new MADBountyCore(IERC20(address(usdc)), treasury, "ipfs://manual", bytes32(0));
        usdc.mint(agent, 100_000e6);
        usdc.mint(worker, 100_000e6);
        vm.prank(agent); usdc.approve(address(core), type(uint256).max);
        vm.prank(worker); usdc.approve(address(core), type(uint256).max);
    }

    function _post(address verifier) internal returns (uint256 id) {
        vm.prank(agent);
        id = core.post(_params(verifier, 100e6, 10e6, MADBountyCore.RejectMode.Burn));
    }

    function test_L0_zeroStep_passesConfigure_and_docNote() public {
        FallbackVerifier fv = new FallbackVerifier(core);
        uint256 id = _post(address(fv));
        address[] memory sg = new address[](1);
        sg[0] = vm.addr(0xA1);
        vm.prank(agent);
        fv.configure(id, sg, 0); // passes: n == 1, so the `n > 1` guard is skipped
        (address[] memory got, uint32 step) = fv.config(id);
        assertEq(got.length, 1);
        assertEq(step, 0);
    }

    /// M-3 (LOW, real): HashRevealVerifier.commit(address) is overloaded with the autogenerated public mapping
    /// getter `commitment(uint256)`.  Actually the "commit" overload is on the ADAPTER itself (`commit(bytes)`),
    /// so there is no name clash inside the adapter; but its readback *is* `commitment(id)`.  no issue.
    /// M-4 (LOW): TeeMLVerifier.configure accepts prefixHash == keccak("") (no prefix).  The MUST-do binding is
    /// still the marker, so no bypass; but then evidence starts at offset 0 and `isJsonStringBody` sees no quote
    /// context at all.  Shown as a config-acceptance test (informational).
    function test_M4_TeeML_emptyPrefix_accepted() public {
        TeeMLVerifier tv = new TeeMLVerifier(core);
        uint256 id = _post(address(tv));
        address[] memory sg = new address[](1);
        sg[0] = vm.addr(0xA1);
        vm.prank(agent);
        tv.configure(id, sg, keccak256(""), keccak256("SUFFIX"));
        (, bytes32 p, bytes32 s) = tv.config(id);
        assertEq(p, keccak256(""));
        assertEq(s, keccak256("SUFFIX"));
    }
}

/// L-0 (INFO, REAL): `FallbackVerifier.configure` only bounds the ladder with `stepTimeout * (n-1) < reviewWindow`
/// for n > 1, so `n == 1 && stepTimeout == 0` (and `n > 1 && stepTimeout == 0`) are accepted.  A zero step makes
/// every signer active at submittedAt, i.e. the backup "outage protection" ladder is a no-op (all signers are
/// equal primaries).  Not exploitable, but the documented "signer i may decide from submittedAt + i*step" promise
/// is silently not delivered.  See test_L0_zeroStep_passesConfigure.
///
/// M-5 (MEDIUM, REAL): OnchainCheckVerifier.configure only rejects `target.code.length == 0` and never re-checks
/// at resolve time, and `check()` treats a *successful* call that returns 0 bytes as `keccak(ret) == expected`,
/// so `expectedResultHash = keccak("")` accepts on ANY empty-returning target (a 1-byte STOP contract, a
/// self-destructed/EOA-delegated EIP-7702 target, a proxy that falls through, etc.).  The check is therefore only
/// as strong as the agent's target choice, which is documented ("trust the target") but the empty-success class is
/// not — a worker can be paid for zero deliverables by a mis-config (or an agent who self-deals).
contract AdapterPoC3Test is CoreHelpers {
    MockUSDC usdc;
    address treasury = makeAddr("treasury");
    address agent = makeAddr("agent");
    address worker = makeAddr("worker");
    bytes32 ev = keccak256("evidence");

    function setUp() public {
        usdc = new MockUSDC();
        core = new MADBountyCore(IERC20(address(usdc)), treasury, "ipfs://manual", bytes32(0));
        usdc.mint(agent, 100_000e6);
        usdc.mint(worker, 100_000e6);
        vm.prank(agent); usdc.approve(address(core), type(uint256).max);
        vm.prank(worker); usdc.approve(address(core), type(uint256).max);
    }

    function test_M5_OnchainCheck_predeploySha256() public {
        OnchainCheckVerifier ocv = new OnchainCheckVerifier(core);
        vm.prank(agent);
        uint256 id = core.post(_params(address(ocv), 100e6, 10e6, MADBountyCore.RejectMode.Burn));
        // Any "code" satisfies the configure guard. A target whose staticcall returns 0 bytes (empty success,
        // e.g. a 1-byte STOP contract) => keccak("") == expected => check passes for EVERY bounty configured so.
        address pre = address(0xc0de);
        vm.etch(pre, hex"00");
        bytes32 expected = keccak256("");
        vm.prank(agent);
        ocv.configure(id, pre, "", expected);
        vm.prank(worker); core.claim(id, 0, "");
        vm.prank(worker); core.submit(id, ev);
        assertTrue(ocv.check(id));
        ocv.resolve(id);
        (,,,,,,,,,,,,, MADBountyCore.State st,) = core.bounties(id);
        assertEq(uint8(st), uint8(MADBountyCore.State.Paid));
    }
}
