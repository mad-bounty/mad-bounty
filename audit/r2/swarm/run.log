     1	// SPDX-License-Identifier: MIT
     2	pragma solidity ^0.8.24;
     3	
     4	import {EIP712} from "@openzeppelin/contracts/utils/cryptography/EIP712.sol";
     5	import {SignatureChecker} from "@openzeppelin/contracts/utils/cryptography/SignatureChecker.sol";
     6	import {MADBountyCore} from "../../src/MADBountyCore.sol";
     7	import {AdapterBase} from "./AdapterBase.sol";
     8	
     9	/// @title FallbackVerifier
    10	/// @notice Verifier-outage protection. Per bounty, an ordered list of up to 3 signers [primary, backup1, backup2]
    11	///         (EOA or ERC-1271) and a step timeout. Signer i may decide once
    12	///         `block.timestamp >= submittedAt + i * stepTimeout`. Earlier signers stay valid; the first verdict that
    13	///         lands wins (core moves the bounty out of Submitted).
    14	///         submittedAt is derived from core: `deadline - reviewWindow` (or `deadline - 2*reviewWindow` if review
    15	///         was extended, since extendReview adds exactly one reviewWindow). An extension therefore does NOT shift
    16	///         the ladder; it only gives later signers more time before the silence timeout pays the worker.
    17	///         Verdicts are EIP-712 over this adapter's domain:
    18	///         Verdict(uint256 id,address worker,bytes32 evidenceHash,bool accept).
    19	///         Reverse (undo a reject during core's 24h cooling) is allowed for the PRIMARY signer only:
    20	///         Reverse(uint256 id,address worker,bytes32 evidenceHash).
    21	///         REFUND-safe: only if every listed signer is independent of the agent.
    22	contract FallbackVerifier is AdapterBase, EIP712 {
    23	    bytes32 public constant VERDICT_TYPEHASH =
    24	        keccak256("Verdict(uint256 id,address worker,bytes32 evidenceHash,bool accept)");
    25	    bytes32 public constant REVERSE_TYPEHASH = keccak256("Reverse(uint256 id,address worker,bytes32 evidenceHash)");
    26	    uint256 public constant MAX_SIGNERS = 3;
    27	
    28	    struct Config {
    29	        address[3] signers;
    30	        uint8 count;
    31	        uint32 stepTimeout;
    32	    }
    33	
    34	    mapping(uint256 => Config) internal _configs;
    35	
    36	    event Configured(uint256 indexed id, address[] signers, uint32 stepTimeout);
    37	    event Resolved(uint256 indexed id, uint256 indexed signerIndex, address signer, bool accept);
    38	    event Reversed(uint256 indexed id, address signer);
    39	
    40	    error BadIndex();
    41	    error TooEarly();
    42	    error BadSig();
    43	
    44	    constructor(MADBountyCore core_) AdapterBase(core_) EIP712("MADBountyFallbackVerifier", "1") {}
    45	
    46	    /// @notice Agent only, while Open, once. `stepTimeout * (n-1)` must be < the bounty's reviewWindow so every
    47	    ///         backup gets a chance before the silence timeout.
    48	    function configure(uint256 id, address[] calldata signers, uint32 stepTimeout) external {
    49	        BountyView memory b = _checkConfigurable(id);
    50	        Config storage c = _configs[id];
    51	        if (c.count != 0) revert AlreadyConfigured();
    52	        uint256 n = signers.length;
    53	        if (n == 0 || n > MAX_SIGNERS) revert BadConfig();
    54	        for (uint256 i; i < n; ++i) {
    55	            if (signers[i] == address(0)) revert BadConfig();
    56	            for (uint256 j; j < i; ++j) if (signers[j] == signers[i]) revert BadConfig();
    57	            c.signers[i] = signers[i];
    58	        }
    59	        if (n > 1 && (stepTimeout == 0 || uint256(stepTimeout) * (n - 1) >= b.reviewWindow)) revert BadConfig();
    60	        c.count = uint8(n);
    61	        c.stepTimeout = stepTimeout;
    62	        emit Configured(id, signers, stepTimeout);
    63	    }
    64	
    65	    function config(uint256 id) external view returns (address[] memory signers, uint32 stepTimeout) {
    66	        Config storage c = _configs[id];
    67	        signers = new address[](c.count);
    68	        for (uint256 i; i < c.count; ++i) signers[i] = c.signers[i];
    69	        stepTimeout = c.stepTimeout;
    70	    }
    71	
    72	    /// @notice Submission time derived from core (valid while Submitted).
    73	    function submittedAt(uint256 id) public view returns (uint256) {
    74	        BountyView memory b = _bounty(id);
    75	        _requireSubmitted(b);
    76	        return uint256(b.deadline) - uint256(b.reviewWindow) * (b.extended ? 2 : 1);
    77	    }
    78	
    79	    /// @notice Timestamp from which signer `i` may decide.
    80	    function activeFrom(uint256 id, uint256 i) public view returns (uint256) {
    81	        return submittedAt(id) + i * _configs[id].stepTimeout;
    82	    }
    83	
    84	    function verdictDigest(uint256 id, address worker, bytes32 evidenceHash, bool accept) public view returns (bytes32) {
    85	        return _hashTypedDataV4(keccak256(abi.encode(VERDICT_TYPEHASH, id, worker, evidenceHash, accept)));
    86	    }
    87	
    88	    function reverseDigest(uint256 id, address worker, bytes32 evidenceHash) public view returns (bytes32) {
    89	        return _hashTypedDataV4(keccak256(abi.encode(REVERSE_TYPEHASH, id, worker, evidenceHash)));
    90	    }
    91	
    92	    /// @notice Permissionless relay of signer `signerIndex`'s verdict.
    93	    function resolve(uint256 id, bool accept, uint256 signerIndex, bytes calldata sig) external {
    94	        Config storage c = _configs[id];
    95	        if (c.count == 0) revert NotConfigured();
    96	        if (signerIndex >= c.count) revert BadIndex();
    97	        BountyView memory b = _bounty(id);
    98	        _requireSubmitted(b);
    99	        uint256 sub = uint256(b.deadline) - uint256(b.reviewWindow) * (b.extended ? 2 : 1);
   100	        if (block.timestamp < sub + signerIndex * c.stepTimeout) revert TooEarly();
   101	        address signer = c.signers[signerIndex];
   102	        if (!SignatureChecker.isValidSignatureNow(signer, verdictDigest(id, b.worker, b.evidenceHash, accept), sig)) {
   103	            revert BadSig();
   104	        }
   105	        emit Resolved(id, signerIndex, signer, accept);
   106	        core.settle(id, accept);
   107	    }
   108	
   109	    /// @notice Permissionless relay of the PRIMARY signer's Reverse intent (core enforces Rejected + cooling).
   110	    function reverse(uint256 id, bytes calldata sig) external {
   111	        Config storage c = _configs[id];
   112	        if (c.count == 0) revert NotConfigured();
   113	        BountyView memory b = _bounty(id);
   114	        address signer = c.signers[0];
   115	        if (!SignatureChecker.isValidSignatureNow(signer, reverseDigest(id, b.worker, b.evidenceHash), sig)) {
   116	            revert BadSig();
   117	        }
   118	        emit Reversed(id, signer);
   119	        core.reverse(id);
   120	    }
   121	}
