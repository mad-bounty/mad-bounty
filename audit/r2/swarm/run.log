     4	/// @notice Naive substring search over bytes. O(n*m); intended for short needles (<= ~100 bytes) and
     5	///         haystacks of a few KB.
     6	library BytesSearch {
     7	    uint256 internal constant NOT_FOUND = type(uint256).max;
     8	
     9	    /// @return idx first index >= from where `needle` occurs in `hay`, or NOT_FOUND. Empty needle → `from`
    10	    ///         if from <= hay.length.
    11	    function indexOf(bytes memory hay, bytes memory needle, uint256 from) internal pure returns (uint256 idx) {
    12	        uint256 n = hay.length;
    13	        uint256 m = needle.length;
    14	        if (m == 0) return from <= n ? from : NOT_FOUND;
    15	        if (m > n || from > n - m) return NOT_FOUND;
    16	        bytes1 first = needle[0];
    17	        uint256 last = n - m;
    18	        for (uint256 i = from; i <= last; ++i) {
    19	            if (hay[i] != first) continue;
    20	            bool ok = true;
    21	            for (uint256 j = 1; j < m; ++j) {
    22	                if (hay[i + j] != needle[j]) { ok = false; break; }
    23	            }
    24	            if (ok) return i;
    25	        }
    26	        return NOT_FOUND;
    27	    }
    28	
    29	    function contains(bytes memory hay, bytes memory needle) internal pure returns (bool) {
    30	        return indexOf(hay, needle, 0) != NOT_FOUND;
    31	    }
    32	}
