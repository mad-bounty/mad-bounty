     1	// SPDX-License-Identifier: MIT
     2	pragma solidity ^0.8.24;
     3	
     4	import {MADBountyCore} from "../../src/MADBountyCore.sol";
     5	
     6	/// @title AdapterBase
     7	/// @notice Shared plumbing for MADBounty verifier adapters. An adapter is a singleton contract named as a
     8	///         bounty's `verifier`; it calls `core.settle` when its rule is satisfied.
     9	///         Invariants shared by every adapter:
    10	///         - Holds no funds (core pays the worker / agent from the per-bounty vault). No owner, no admin, no upgrade.
    11	///         - Per-bounty config is written once, only by the bounty's agent, only while the bounty is still Open
    12	///           (so a worker can read the rule before staking a deposit), and only if this adapter is the verifier.
    13	///         - An unconfigured bounty can never be settled by the adapter: core's verifier-silence timeout pays
    14	///           the worker. Workers MUST check the config exists before claiming.
    15	abstract contract AdapterBase {
    16	    MADBountyCore public immutable core;
    17	
    18	    struct BountyView {
    19	        address agent;
    20	        address verifier;
    21	        address worker;
    22	        uint32 reviewWindow;
    23	        uint64 deadline;
    24	        bool extended;
    25	        MADBountyCore.State state;
    26	        bytes32 evidenceHash;
    27	    }
    28	
    29	    error BadConfig();
    30	    error NotAgent();
    31	    error NotVerifier();
    32	    error NotOpen();
    33	    error NotSubmitted();
    34	    error AlreadyConfigured();
    35	    error NotConfigured();
    36	
    37	    constructor(MADBountyCore core_) {
    38	        if (address(core_) == address(0)) revert BadConfig();
    39	        core = core_;
    40	    }
    41	
    42	    function _bounty(uint256 id) internal view returns (BountyView memory v) {
    43	        (
    44	            address agent,
    45	            address verifier,
    46	            ,
    47	            address worker,
    48	            ,
    49	            ,
    50	            ,
    51	            ,
    52	            uint32 reviewWindow,
    53	            ,
    54	            uint64 deadline,
    55	            bool extended,
    56	            ,
    57	            MADBountyCore.State state,
    58	            bytes32 evidenceHash
    59	        ) = core.bounties(id);
    60	        v = BountyView(agent, verifier, worker, reviewWindow, deadline, extended, state, evidenceHash);
    61	    }
    62	
    63	    /// @dev Caller is the agent, bounty is Open, and this adapter is the bounty's verifier.
    64	    function _checkConfigurable(uint256 id) internal view returns (BountyView memory b) {
    65	        b = _bounty(id);
    66	        if (b.state != MADBountyCore.State.Open) revert NotOpen();
    67	        if (msg.sender != b.agent) revert NotAgent();
    68	        if (b.verifier != address(this)) revert NotVerifier();
    69	    }
    70	
    71	    function _requireSubmitted(BountyView memory b) internal pure {
    72	        if (b.state != MADBountyCore.State.Submitted) revert NotSubmitted();
    73	    }
    74	}
