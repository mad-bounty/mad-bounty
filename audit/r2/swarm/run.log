/// L-1 PoC: FallbackVerifier.configure accepts n == 1 AND stepTimeout == 0 (the `n > 1` guard leaves the
/// single-signer case unguarded).  That is fine for resolve (0*0 = 0), but it is the same acceptance that lets
/// n == 3 + step 0 through — see L-0.  Kept as documentation that `stepTimeout == 0` is a legal configuration.
contract AdapterPoC2Test is CoreHelpers {
    MockUSDC usdc;
    address treasury = makeAddr("treasury");
    address agent = makeAddr("agent");
    address worker = makeAddr("worker");
    address stranger = makeAddr("stranger");
