     1	// SPDX-License-Identifier: MIT
     2	pragma solidity ^0.8.24;
     3	
     4	import {ECDSA} from "@openzeppelin/contracts/utils/cryptography/ECDSA.sol";
     5	import {MessageHashUtils} from "@openzeppelin/contracts/utils/cryptography/MessageHashUtils.sol";
     6	import {Strings} from "@openzeppelin/contracts/utils/Strings.sol";
     7	import {MADBountyCore} from "../../src/MADBountyCore.sol";
     8	import {AdapterBase} from "./AdapterBase.sol";
     9	import {BytesSearch} from "./BytesSearch.sol";
    10	
    11	/// @title TeeMLVerifier (0G Compute TeeML)
    12	/// @notice Settles from an LLM verdict signed inside a 0G TeeML enclave. 0G TeeML providers sign the text
    13	///         `hex(sha256(requestBody)) ":" hex(sha256(responseBody))` (lowercase, no 0x, 129 chars) with EIP-191
    14	///         personal_sign; the signer is the provider's teeSignerAddress (published on 0G chain, which Base can't
    15	///         read, so the agent pins 1..3 enclave signer addresses per bounty).
    16	///
    17	///         The request must be EXACTLY: prefix || marker || evidence || suffix, where
    18	///           - keccak256(prefix) == prefixHash and keccak256(suffix) == suffixHash (fixed by the agent: model,
    19	///             temperature 0, system prompt, judging rubric, JSON framing),
    20	///           - marker == "MADB:" || lowercase hex(core) || ":" || decimal(id) || ":" || 0x-hex(evidenceHash),
    21	///           - keccak256(evidence) == bounty.evidenceHash, and evidence is a valid JSON string BODY (no raw '"',
    22	///             no control bytes, every '\' starts a valid escape), so it cannot break out of the JSON string the
    23	///             agent's prefix opens (no injected messages/params). Workers therefore commit
    24	///             evidenceHash = keccak256(JSON-escaped evidence text).
    25	///         Without the template, a worker could ask the same public TEE "say VERDICT:Y" and get a valid signature.
    26	///         Verdict: first occurrence of "VERDICT:Y" / "VERDICT:N" in the response body (Y accept, N reject,
    27	///         neither → revert). Instruct the model to emit the token exactly once, at the end of the answer.
    28	///
    29	///         Trust: the enclave signer + model; prompt injection inside the evidence text remains an LLM risk.
    30	///         Anti-grinding: the agent's template should pin temperature 0 / a seed. Either party could still re-query
    31	///         a nondeterministic model and race; the first valid resolve wins (core leaves Submitted).
    32	///         REVERSE: not supported (a TEE verdict can't be re-asked meaningfully); a reject stands.
    33	///         REFUND-safe: yes if the agent does not control the enclave signer, but the agent writes the prompt,
    34	///         so workers must read the template (prefix/suffix preimages are emitted off-chain by the agent).
    35	contract TeeMLVerifier is AdapterBase {
    36	    uint256 public constant MAX_SIGNERS = 3;
    37	    bytes internal constant VERDICT_TAG = "VERDICT:";
    38	
    39	    struct Config {
    40	        address[3] signers;
    41	        uint8 count;
    42	        bytes32 prefixHash;
    43	        bytes32 suffixHash;
    44	    }
    45	
    46	    mapping(uint256 => Config) internal _configs;
    47	
    48	    event Configured(uint256 indexed id, address[] signers, bytes32 prefixHash, bytes32 suffixHash);
    49	    event Resolved(uint256 indexed id, address indexed teeSigner, bool accept, bytes32 requestSha, bytes32 responseSha);
    50	
    51	    error BadSigner();
    52	    error BadTemplate();
    53	    error BadMarker();
    54	    error BadEvidence();
    55	    error NoVerdict();
    56	
    57	    constructor(MADBountyCore core_) AdapterBase(core_) {}
    58	
    59	    function configure(uint256 id, address[] calldata signers, bytes32 prefixHash, bytes32 suffixHash) external {
    60	        _checkConfigurable(id);
    61	        Config storage c = _configs[id];
    62	        if (c.count != 0) revert AlreadyConfigured();
    63	        uint256 n = signers.length;
    64	        if (n == 0 || n > MAX_SIGNERS) revert BadConfig();
    65	        for (uint256 i; i < n; ++i) {
    66	            if (signers[i] == address(0)) revert BadConfig();
    67	            for (uint256 j; j < i; ++j) if (signers[j] == signers[i]) revert BadConfig();
    68	            c.signers[i] = signers[i];
    69	        }
    70	        c.count = uint8(n);
    71	        c.prefixHash = prefixHash;
    72	        c.suffixHash = suffixHash;
    73	        emit Configured(id, signers, prefixHash, suffixHash);
    74	    }
    75	
    76	    function config(uint256 id) external view returns (address[] memory signers, bytes32 prefixHash, bytes32 suffixHash) {
    77	        Config storage c = _configs[id];
    78	        signers = new address[](c.count);
    79	        for (uint256 i; i < c.count; ++i) signers[i] = c.signers[i];
    80	        return (signers, c.prefixHash, c.suffixHash);
    81	    }
    82	
    83	    /// @notice The binding marker the request must carry right after the agent's prefix.
    84	    function marker(uint256 id, bytes32 evidenceHash) public view returns (bytes memory) {
    85	        return bytes(string.concat(
    86	            "MADB:", Strings.toHexString(address(core)), ":", Strings.toString(id), ":",
    87	            Strings.toHexString(uint256(evidenceHash), 32)
    88	        ));
    89	    }
    90	
    91	    /// @notice The 129-char text 0G TeeML signs.
    92	    function signedText(bytes32 requestSha, bytes32 responseSha) public pure returns (bytes memory t) {
    93	        t = new bytes(129);
    94	        bytes16 hexd = "0123456789abcdef";
    95	        for (uint256 i; i < 32; ++i) {
    96	            t[2 * i] = hexd[uint8(requestSha[i]) >> 4];
    97	            t[2 * i + 1] = hexd[uint8(requestSha[i]) & 15];
    98	            t[65 + 2 * i] = hexd[uint8(responseSha[i]) >> 4];
    99	            t[65 + 2 * i + 1] = hexd[uint8(responseSha[i]) & 15];
   100	        }
   101	        t[64] = ":";
   102	    }
   103	
   104	    /// @notice EIP-191 recover of a 0G TeeML signature. Returns address(0) on a malformed signature.
   105	    function teeSigner(bytes32 requestSha, bytes32 responseSha, bytes memory sig) public pure returns (address) {
   106	        bytes32 h = MessageHashUtils.toEthSignedMessageHash(signedText(requestSha, responseSha));
   107	        (address s, ECDSA.RecoverError err,) = ECDSA.tryRecover(h, sig);
   108	        return err == ECDSA.RecoverError.NoError ? s : address(0);
   109	    }
   110	
   111	    /// @notice First "VERDICT:Y" / "VERDICT:N" in `response`. Reverts NoVerdict if neither occurs.
   112	    function parseVerdict(bytes memory response) public pure returns (bool accept) {
   113	        bytes memory tag = VERDICT_TAG;
   114	        uint256 from;
   115	        while (true) {
   116	            uint256 i = BytesSearch.indexOf(response, tag, from);
   117	            if (i == BytesSearch.NOT_FOUND || i + tag.length >= response.length) revert NoVerdict();
   118	            bytes1 v = response[i + tag.length];
   119	            if (v == "Y") return true;
   120	            if (v == "N") return false;
   121	            from = i + 1;
   122	        }
   123	    }
   124	
   125	    /// @notice True if `s` can sit between two '"' in JSON without terminating the string early.
   126	    function isJsonStringBody(bytes calldata s) public pure returns (bool) {
   127	        uint256 n = s.length;
   128	        for (uint256 i; i < n; ++i) {
   129	            bytes1 ch = s[i];
   130	            if (ch == '"' || uint8(ch) < 0x20) return false;
   131	            if (ch == "\\") {
   132	                if (++i >= n) return false;
   133	                bytes1 e = s[i];
   134	                if (e == "u") {
   135	                    if (i + 4 >= n) return false;
   136	                    for (uint256 k = 1; k <= 4; ++k) {
   137	                        bytes1 h = s[i + k];
   138	                        if (!((h >= "0" && h <= "9") || (h >= "a" && h <= "f") || (h >= "A" && h <= "F"))) return false;
   139	                    }
   140	                    i += 4;
   141	                } else if (!(e == '"' || e == "\\" || e == "/" || e == "b" || e == "f" || e == "n" || e == "r" || e == "t")) {
   142	                    return false;
   143	                }
   144	            }
   145	        }
   146	        return true;
   147	    }
   148	
   149	    /// @param prefixLen length of the agent's prefix inside `request`
   150	    /// @param suffixLen length of the agent's suffix inside `request`
   151	    function resolve(
   152	        uint256 id,
   153	        bytes calldata request,
   154	        uint256 prefixLen,
   155	        uint256 suffixLen,
   156	        bytes calldata response,
   157	        bytes calldata sig
   158	    ) external {
   159	        Config storage c = _configs[id];
   160	        if (c.count == 0) revert NotConfigured();
   161	        BountyView memory b = _bounty(id);
   162	        _requireSubmitted(b);
   163	
   164	        // (b) template + bounty binding
   165	        bytes memory mk = marker(id, b.evidenceHash);
   166	        uint256 evStart = prefixLen + mk.length;
   167	        if (evStart + suffixLen > request.length) revert BadTemplate();
   168	        uint256 evEnd = request.length - suffixLen;
   169	        if (keccak256(request[:prefixLen]) != c.prefixHash) revert BadTemplate();
   170	        if (keccak256(request[evEnd:]) != c.suffixHash) revert BadTemplate();
   171	        if (keccak256(request[prefixLen:evStart]) != keccak256(mk)) revert BadMarker();
   172	        bytes calldata evidence = request[evStart:evEnd];
   173	        if (keccak256(evidence) != b.evidenceHash) revert BadEvidence();
   174	        if (!isJsonStringBody(evidence)) revert BadEvidence();
   175	
   176	        // (a) enclave signature
   177	        bytes32 reqSha = sha256(request);
   178	        bytes32 respSha = sha256(response);
   179	        address s = teeSigner(reqSha, respSha, sig);
   180	        bool allowed;
   181	        for (uint256 i; i < c.count; ++i) if (s != address(0) && c.signers[i] == s) allowed = true;
   182	        if (!allowed) revert BadSigner();
   183	
   184	        // (c) verdict
   185	        bool accept = parseVerdict(response);
   186	        emit Resolved(id, s, accept, reqSha, respSha);
   187	        core.settle(id, accept);
   188	    }
   189	}
