     1	// SPDX-License-Identifier: MIT
     2	pragma solidity ^0.8.24;
     3	
     4	import {MADBountyCore} from "../../src/MADBountyCore.sol";
     5	import {AdapterBase} from "./AdapterBase.sol";
     6	
     7	/// @title HashRevealVerifier
     8	/// @notice Agent commits `keccak256(abi.encode(answer))` (answer: bytes). The bounty's worker calls
     9	///         `reveal(id, answer)` after submitting; a matching answer accepts. ACCEPT-ONLY, so REFUND-safe.
    10	///         WARNING: the answer becomes public on reveal (calldata + event). Use it for answers that are fine to
    11	///         publish, or make the committed answer a hash of private data. Low-entropy answers can be brute-forced
    12	///         from the commitment; salt them (e.g. answer = abi.encode(realAnswer, salt) and tell the worker how
    13	///         the salt is derived from the work).
    14	///         Front-running is harmless: only `bounty.worker` may reveal, and core pays `bounty.worker` regardless of
    15	///         who calls, so a watcher copying the answer from the mempool can neither reveal nor redirect payment.
    16	///         (An answer copied from another bounty's reveal is the agent's choice of a reused commitment.)
    17	contract HashRevealVerifier is AdapterBase {
    18	    mapping(uint256 => bytes32) public commitment;
    19	
    20	    event Configured(uint256 indexed id, bytes32 commitment);
    21	    event Revealed(uint256 indexed id, address indexed worker, bytes answer);
    22	
    23	    error NotWorker();
    24	    error WrongAnswer();
    25	
    26	    constructor(MADBountyCore core_) AdapterBase(core_) {}
    27	
    28	    function configure(uint256 id, bytes32 commitment_) external {
    29	        _checkConfigurable(id);
    30	        if (commitment[id] != bytes32(0)) revert AlreadyConfigured();
    31	        if (commitment_ == bytes32(0)) revert BadConfig();
    32	        commitment[id] = commitment_;
    33	        emit Configured(id, commitment_);
    34	    }
    35	
    36	    function commit(bytes calldata answer) external pure returns (bytes32) {
    37	        return keccak256(abi.encode(answer));
    38	    }
    39	
    40	    function reveal(uint256 id, bytes calldata answer) external {
    41	        bytes32 c = commitment[id];
    42	        if (c == bytes32(0)) revert NotConfigured();
    43	        BountyView memory b = _bounty(id);
    44	        _requireSubmitted(b);
    45	        if (msg.sender != b.worker) revert NotWorker();
    46	        if (keccak256(abi.encode(answer)) != c) revert WrongAnswer();
    47	        emit Revealed(id, msg.sender, answer);
    48	        core.settle(id, true);
    49	    }
    50	}
