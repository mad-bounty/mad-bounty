     1	// SPDX-License-Identifier: MIT
     2	pragma solidity ^0.8.24;
     3	
     4	import {MADBountyCore} from "../../src/MADBountyCore.sol";
     5	import {AdapterBase} from "./AdapterBase.sol";
     6	
     7	/// @title OnchainCheckVerifier
     8	/// @notice Accept when `keccak256(returndata of target.staticcall(data)) == expectedResultHash`.
     9	///         ACCEPT-ONLY: this adapter can never reject. If the check never passes, core's verifier-silence timeout
    10	///         pays the worker anyway, so the adapter only lets a worker be paid EARLY. Because it never rejects,
    11	///         it is REFUND-safe (the agent cannot use it to take the work and recover the reward).
    12	///         Trust: the check is evaluated at resolve time. If the target's state is manipulable by anyone (e.g. a
    13	///         token balance someone can donate to, a spot price), anyone can make it pass transiently. That only
    14	///         pays the worker early, which the agent accepted by choosing the check.
    15	///         The staticcall is capped at CHECK_GAS; a revert or out-of-gas counts as "not passed" (resolve reverts,
    16	///         no state change).
    17	contract OnchainCheckVerifier is AdapterBase {
    18	    uint256 public constant CHECK_GAS = 200_000;
    19	    uint256 public constant MAX_DATA = 4096;
    20	
    21	    struct Config {
    22	        address target;
    23	        bytes32 expectedResultHash;
    24	        bytes data;
    25	    }
    26	
    27	    mapping(uint256 => Config) internal _configs;
    28	
    29	    event Configured(uint256 indexed id, address indexed target, bytes data, bytes32 expectedResultHash);
    30	    event Resolved(uint256 indexed id, address indexed caller);
    31	
    32	    error CheckFailed();
    33	
    34	    constructor(MADBountyCore core_) AdapterBase(core_) {}
    35	
    36	    /// @notice Agent only, while Open, once. `target` must have code (an EOA staticcall "succeeds" with empty data).
    37	    function configure(uint256 id, address target, bytes calldata data, bytes32 expectedResultHash) external {
    38	        _checkConfigurable(id);
    39	        if (_configs[id].target != address(0)) revert AlreadyConfigured();
    40	        if (target.code.length == 0 || data.length > MAX_DATA) revert BadConfig();
    41	        _configs[id] = Config(target, expectedResultHash, data);
    42	        emit Configured(id, target, data, expectedResultHash);
    43	    }
    44	
    45	    function config(uint256 id) external view returns (address target, bytes memory data, bytes32 expectedResultHash) {
    46	        Config storage c = _configs[id];
    47	        return (c.target, c.data, c.expectedResultHash);
    48	    }
    49	
    50	    /// @notice True when the configured check currently passes.
    51	    function check(uint256 id) public view returns (bool) {
    52	        Config storage c = _configs[id];
    53	        if (c.target == address(0)) return false;
    54	        (bool ok, bytes memory ret) = c.target.staticcall{gas: CHECK_GAS}(c.data);
    55	        return ok && keccak256(ret) == c.expectedResultHash;
    56	    }
    57	
    58	    /// @notice Permissionless keeper: if the check passes, accept. Never rejects.
    59	    function resolve(uint256 id) external {
    60	        if (_configs[id].target == address(0)) revert NotConfigured();
    61	        if (!check(id)) revert CheckFailed();
    62	        emit Resolved(id, msg.sender);
    63	        core.settle(id, true);
    64	    }
    65	}
