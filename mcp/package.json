{
  "name": "@madbounty/mcp",
  "version": "0.1.0",
  "description": "MCP server for MAD Bounty: post, claim, verify and settle USDC bounties on Base from any agent harness",
  "type": "module",
  "license": "MIT",
  "bin": {
    "madbounty-mcp": "./dist/index.js"
  },
  "main": "./dist/server.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "build:sdk": "npm --prefix ../sdk run build",
    "test": "npm run build:sdk && npm run build && vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@madbounty/sdk": "file:../sdk",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "viem": "^2.58.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
